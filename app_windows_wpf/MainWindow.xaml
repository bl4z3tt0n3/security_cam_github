<Window x:Class="LocalSecurityMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Security Monitor"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="CameraTileTemplate">
            <Button Style="{StaticResource TileButtonStyle}"
                    Tag="{Binding CameraId}"
                    Click="CameraTile_Click"
                    AutomationProperties.Name="{Binding CameraId}">
                <Grid MinHeight="170">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource DarkVideoBrush}">
                        <Grid>
                            <Image Source="{Binding DisplayImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Visibility="{Binding EmptyVisibility}"
                                       Foreground="#D1D5DB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="18" />
                            <Border Background="#EFFFFFFF"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="7,3">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                            <Border Background="{Binding StatusBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="7,3">
                                <TextBlock Text="{Binding Status}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SlotLabel}"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="11" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MetaText}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="8,0,10,0" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="FaceGalleryActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FaceGalleryDeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FaceGalleryActionButtonStyle}">
            <Setter Property="Foreground" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#F2B8B5" />
        </Style>

        <Style x:Key="FaceGalleryRootButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource FaceGalleryActionButtonStyle}">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="Esci" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Visualizza">
                <MenuItem Header="Griglia camere" Click="BackToGrid_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatusText"
                           Text="Avvio del backend locale…"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Right">
                <TextBlock x:Name="FooterConfigText"
                           Text=""
                           Foreground="{StaticResource SubtleTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="14,10,14,10">
            <Grid x:Name="GridView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Local Security Monitor"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Monitor locale delle sorgenti video"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <Border Background="#E8EEF9"
                                BorderBrush="#C7D6F2"
                                BorderThickness="1"
                                Padding="9,5"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="EnvironmentText"
                                       Text="BACKEND LOCALE"
                                       Foreground="#1D4ED8"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Button Content="Aggiorna stato"
                                Style="{StaticResource CommandButtonStyle}"
                                Click="Refresh_Click" />
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Cameras}"
                              ItemTemplate="{StaticResource CameraTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>

            <Grid x:Name="FocusView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="← Tutte le camere"
                            Style="{StaticResource CommandButtonStyle}"
                            Click="BackToGrid_Click" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock x:Name="FocusTitleText"
                                   Text="Camera"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="FocusMetaText"
                                   Text=""
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Background="#E5E7EB"
                            Padding="9,5"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="FocusStatusText"
                                   Text=""
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="450" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="1.25*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource DarkVideoBrush}"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">
                        <Grid>
                            <Image x:Name="FocusImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="FocusEmptyText"
                                       Text="Seleziona una camera"
                                       Foreground="#D1D5DB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="20" />
                            <Canvas x:Name="DetectionCanvas"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True" />
                            <Border Background="#D910172A"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="10"
                                    Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RotateButton"
                                            Content="Ruota 90°"
                                            Style="{StaticResource CommandButtonStyle}"
                                            Click="RotateButton_Click"
                                            Margin="0,0,5,0" />
                                    <CheckBox x:Name="MirrorCheckBox"
                                              Content="Specchia"
                                              Foreground="White"
                                              VerticalAlignment="Center"
                                              Checked="MirrorCheckBox_Changed"
                                              Unchecked="MirrorCheckBox_Changed" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#CBD5E1"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="False" />

                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,0,2,0">
                        <StackPanel>
                            <GroupBox Header="Configurazione camera">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Content="ID camera" />
                                    <TextBlock x:Name="CameraIdText" Grid.Row="0" Grid.Column="1" Margin="0,3,0,9" />
                                    <Label Grid.Row="1" Content="Nome" />
                                    <TextBox x:Name="CameraNameBox" Grid.Row="1" Grid.Column="1" TextChanged="CameraEditorChanged" />
                                    <Label Grid.Row="2" Content="Stato" />
                                    <CheckBox x:Name="CameraEnabledCheckBox" Grid.Row="2" Grid.Column="1" Content="Camera abilitata" Margin="0,3,0,8" Checked="CameraEditorChanged" Unchecked="CameraEditorChanged" />
                                    <Label Grid.Row="3" Content="Schema" />
                                    <ComboBox x:Name="CameraSchemeCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="CameraEditorChanged">
                                        <ComboBoxItem Content="rtsp" Tag="rtsp" />
                                        <ComboBoxItem Content="rtsps" Tag="rtsps" />
                                        <ComboBoxItem Content="http" Tag="http" />
                                        <ComboBoxItem Content="https" Tag="https" />
                                    </ComboBox>
                                    <Label Grid.Row="4" Content="Host / IP" />
                                    <TextBox x:Name="CameraHostBox" Grid.Row="4" Grid.Column="1" TextChanged="CameraEditorChanged" />
                                    <Label Grid.Row="5" Content="Porta" />
                                    <TextBox x:Name="CameraPortBox" Grid.Row="5" Grid.Column="1" TextChanged="CameraEditorChanged" />
                                    <Label Grid.Row="6" Content="Path" />
                                    <TextBox x:Name="CameraPathBox" Grid.Row="6" Grid.Column="1" TextChanged="CameraEditorChanged" />
                                    <Label Grid.Row="7" Content="Username" />
                                    <TextBox x:Name="CameraUsernameBox" Grid.Row="7" Grid.Column="1" TextChanged="CameraEditorChanged" />
                                    <Label Grid.Row="8" Content="Password" />
                                    <PasswordBox x:Name="CameraPasswordBox" Grid.Row="8" Grid.Column="1" PasswordChanged="CameraEditorChanged" Margin="0,0,0,7" />
                                    <Label Grid.Row="9" Content="" />
                                    <CheckBox x:Name="ClearPasswordCheckBox" Grid.Row="9" Grid.Column="1" Content="Rimuovi password salvata" Margin="0,1,0,8" Checked="CameraEditorChanged" Unchecked="CameraEditorChanged" />
                                    <Label Grid.Row="10" Content="Trasporto" />
                                    <ComboBox x:Name="CameraTransportCombo" Grid.Row="10" Grid.Column="1" SelectionChanged="CameraEditorChanged">
                                        <ComboBoxItem Content="TCP" Tag="tcp" />
                                        <ComboBoxItem Content="UDP" Tag="udp" />
                                        <ComboBoxItem Content="AUTO" Tag="auto" />
                                    </ComboBox>
                                    <Label Grid.Row="11" Content="URL redatta" />
                                    <TextBlock x:Name="CameraUrlPreviewText" Grid.Row="11" Grid.Column="1" TextWrapping="Wrap" Margin="0,3,0,9" Foreground="{StaticResource SubtleTextBrush}" />
                                    <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="TestConnectionButton" Content="Test connessione" Style="{StaticResource CommandButtonStyle}" Click="TestConnection_Click" />
                                        <Button Content="Applica ora" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyCameraNow_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="CameraConfigStatusText" Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource SubtleTextBrush}" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Rilevamento persone">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="DetectionEnabledCheckBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Abilita analisi locale" Margin="0,0,0,9" Checked="PersonSettingsChanged" Unchecked="PersonSettingsChanged" />
                                    <Label Grid.Row="1" Content="Backend" />
                                    <ComboBox x:Name="DetectionBackendCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="DetectionBackendChanged">
                                        <ComboBoxItem Content="Automatico" Tag="auto" />
                                        <ComboBoxItem Content="OpenVINO" Tag="openvino" />
                                        <ComboBoxItem Content="YOLOE" Tag="yoloe" />
                                        <ComboBoxItem Content="ONNX legacy" Tag="onnx" />
                                        <ComboBoxItem Content="Fake offline" Tag="fake" />
                                    </ComboBox>
                                    <Label Grid.Row="2" Content="Modello" />
                                    <ComboBox x:Name="DetectionModelCombo"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              SelectionChanged="PersonSettingsChanged"
                                              ToolTip="Modelli compatibili con il backend selezionato" />
                                    <Label Grid.Row="3" Content="Categorie" />
                                    <TextBox x:Name="DetectionPromptsBox" Grid.Row="3" Grid.Column="1" TextChanged="PersonSettingsChanged" ToolTip="Categorie separate da virgola" />
                                    <Label Grid.Row="4" Content="Dispositivo" />
                                    <ComboBox x:Name="DetectionDeviceCombo" Grid.Row="4" Grid.Column="1" SelectionChanged="PersonSettingsChanged">
                                        <ComboBoxItem Content="Auto" Tag="auto" />
                                        <ComboBoxItem Content="CPU" Tag="cpu" />
                                        <ComboBoxItem Content="GPU" Tag="gpu" />
                                        <ComboBoxItem Content="CUDA" Tag="cuda" />
                                    </ComboBox>
                                    <Label Grid.Row="5" Content="Precisione" />
                                    <ComboBox x:Name="DetectionPrecisionCombo" Grid.Row="5" Grid.Column="1" SelectionChanged="PersonSettingsChanged">
                                        <ComboBoxItem Content="FP16" Tag="fp16" />
                                        <ComboBoxItem Content="FP32" Tag="fp32" />
                                    </ComboBox>
                                    <Label Grid.Row="6" Content="Fallback" />
                                    <ComboBox x:Name="DetectionFallbackCombo" Grid.Row="6" Grid.Column="1" SelectionChanged="PersonSettingsChanged">
                                        <ComboBoxItem Content="Nessuno" Tag="none" />
                                        <ComboBoxItem Content="CPU" Tag="cpu" />
                                    </ComboBox>
                                    <Label Grid.Row="7" Content="Confidenza" />
                                    <Grid Grid.Row="7" Grid.Column="1" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="DetectionConfidenceSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="PersonSettingsChanged" />
                                        <TextBlock x:Name="DetectionConfidenceValue" Grid.Column="1" Text="50%" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Label Grid.Row="8" Content="FPS inferenza" />
                                    <TextBox x:Name="DetectionFpsBox" Grid.Row="8" Grid.Column="1" TextChanged="PersonSettingsChanged" />
                                    <Label Grid.Row="9" Content="Dimensione input" />
                                    <TextBox x:Name="DetectionImageSizeBox" Grid.Row="9" Grid.Column="1" TextChanged="PersonSettingsChanged" />
                                    <CheckBox x:Name="DetectionShowBoxesCheckBox" Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Content="Mostra bounding box" Margin="0,0,0,6" Checked="PersonSettingsChanged" Unchecked="PersonSettingsChanged" />
                                    <CheckBox x:Name="DetectionShowMasksCheckBox" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Content="Mostra maschere YOLOE" Margin="0,0,0,4" Checked="PersonSettingsChanged" Unchecked="PersonSettingsChanged" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Face detection / recognition">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="FaceDetectionEnabledCheckBox" AutomationProperties.AutomationId="FaceDetectionEnabled" Grid.Row="0" Grid.ColumnSpan="2" Content="Abilita face detection" Checked="FaceSettingsChanged" Unchecked="FaceSettingsChanged" Margin="0,0,0,6" />
                                    <Label Grid.Row="1" Content="Detector" />
                                    <ComboBox x:Name="FaceDetectorCombo" AutomationProperties.AutomationId="FaceDetectorCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="FaceSettingsSelectionChanged" />
                                    <Label Grid.Row="2" Content="Backend / device" />
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="FaceDetectorBackendCombo" AutomationProperties.AutomationId="FaceDetectorBackendCombo" Grid.Column="0" SelectionChanged="FaceSettingsSelectionChanged" />
                                        <ComboBox x:Name="FaceDetectorDeviceCombo" AutomationProperties.AutomationId="FaceDetectorDeviceCombo" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="FaceSettingsSelectionChanged" />
                                    </Grid>
                                    <Label Grid.Row="3" Content="Modello detector" />
                                    <TextBox x:Name="FaceDetectorModelBox" AutomationProperties.AutomationId="FaceDetectorModel" Grid.Row="3" Grid.Column="1" TextChanged="FaceSettingsTextChanged" />
                                    <Label Grid.Row="4" Content="Confidenza minima" />
                                    <Grid Grid.Row="4" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="FaceDetectorConfidenceSlider" AutomationProperties.AutomationId="FaceDetectorConfidenceSlider" Minimum="1" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FaceConfidenceSliderChanged" />
                                        <TextBlock x:Name="FaceDetectorConfidenceValue" AutomationProperties.AutomationId="FaceDetectorConfidenceValue" Grid.Column="1" Width="48" Text="50%" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="5" Text="Sampling detector (FPS)" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBox x:Name="FaceDetectorFpsBox" Grid.Row="5" Grid.Column="1" TextChanged="FaceSettingsTextChanged" ToolTip="Sampling detector" />
                                    <Label Grid.Row="6" Content="Landmark" />
                                    <CheckBox x:Name="FaceLandmarksEnabledCheckBox" AutomationProperties.AutomationId="FaceLandmarksEnabled" Grid.Row="6" Grid.Column="1" Content="Abilita landmarks" Checked="FaceSettingsChanged" Unchecked="FaceSettingsChanged" />
                                    <TextBlock Grid.Row="7" Text="Modello landmark" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ComboBox x:Name="FaceLandmarkerCombo" AutomationProperties.AutomationId="FaceLandmarkerCombo" Grid.Row="7" Grid.Column="1" SelectionChanged="FaceSettingsSelectionChanged" />
                                    <TextBlock Grid.Row="8" Text="Device landmark" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <ComboBox x:Name="FaceLandmarkerDeviceCombo" AutomationProperties.AutomationId="FaceLandmarkerDeviceCombo" Grid.Row="8" Grid.Column="1" SelectionChanged="FaceSettingsSelectionChanged" />
                                    <CheckBox x:Name="FaceRecognitionEnabledCheckBox" AutomationProperties.AutomationId="FaceRecognitionEnabled" Grid.Row="9" Grid.ColumnSpan="2" Content="Abilita face recognition" Checked="FaceSettingsChanged" Unchecked="FaceSettingsChanged" Margin="0,7,0,6" />
                                    <Label Grid.Row="10" Content="Recognizer" />
                                    <ComboBox x:Name="FaceRecognizerCombo" AutomationProperties.AutomationId="FaceRecognizerCombo" Grid.Row="10" Grid.Column="1" SelectionChanged="FaceSettingsSelectionChanged" />
                                    <Label Grid.Row="11" Content="Backend / device" />
                                    <Grid Grid.Row="11" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="FaceRecognizerBackendCombo" AutomationProperties.AutomationId="FaceRecognizerBackendCombo" Grid.Column="0" SelectionChanged="FaceSettingsSelectionChanged" />
                                        <ComboBox x:Name="FaceRecognizerDeviceCombo" AutomationProperties.AutomationId="FaceRecognizerDeviceCombo" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="FaceSettingsSelectionChanged" />
                                    </Grid>
                                    <TextBlock Grid.Row="12" Text="Modello recognizer" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBox x:Name="FaceRecognizerModelBox" AutomationProperties.AutomationId="FaceRecognizerModel" Grid.Row="12" Grid.Column="1" TextChanged="FaceSettingsTextChanged" />
                                    <TextBlock Grid.Row="13" Text="Soglia similarità" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Grid Grid.Row="13" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="FaceRecognitionThresholdEnabledCheckBox" AutomationProperties.AutomationId="FaceRecognitionThresholdEnabled" Content="Attiva" VerticalAlignment="Center" Checked="FaceRecognitionThresholdToggleChanged" Unchecked="FaceRecognitionThresholdToggleChanged" Margin="0,0,8,0" />
                                        <Slider x:Name="FaceRecognitionThresholdSlider" AutomationProperties.AutomationId="FaceRecognitionThresholdSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FaceRecognitionThresholdSliderChanged" />
                                        <TextBlock x:Name="FaceRecognitionThresholdValue" AutomationProperties.AutomationId="FaceRecognitionThresholdValue" Grid.Column="2" Width="70" Text="disattivata" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Row="14" Text="Conferme consecutive" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBox x:Name="FaceRecognitionConfirmationsBox" AutomationProperties.AutomationId="FaceRecognitionConfirmations" Grid.Row="14" Grid.Column="1" ToolTip="Numero minimo di conferme consecutive" TextChanged="FaceSettingsTextChanged" />
                                    <TextBlock Grid.Row="15" Text="Finestra conferme (s)" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBox x:Name="FaceRecognitionWindowBox" AutomationProperties.AutomationId="FaceRecognitionWindow" Grid.Row="15" Grid.Column="1" ToolTip="Finestra temporale delle conferme in secondi" TextChanged="FaceSettingsTextChanged" />
                                    <TextBlock Grid.Row="16" Text="Sampling recognition (FPS)" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <TextBox x:Name="FaceRecognitionFpsBox" AutomationProperties.AutomationId="FaceRecognitionFps" Grid.Row="16" Grid.Column="1" TextChanged="FaceSettingsTextChanged" ToolTip="Frequenza di inferenza recognition in FPS" />
                                    <TextBlock x:Name="FaceDetectionStatusText" AutomationProperties.AutomationId="FaceDetectionStatus" Grid.Row="17" Grid.ColumnSpan="2" Text="DISABILITATO" TextWrapping="Wrap" Margin="0,8,0,2" />
                                    <TextBlock x:Name="FaceStatusText" AutomationProperties.AutomationId="FaceStatus" Grid.Row="18" Grid.ColumnSpan="2" Text="DISABILITATO" TextWrapping="Wrap" Margin="0,2,0,4" />
                                    <TextBlock x:Name="FaceTelemetryText" AutomationProperties.AutomationId="FaceTelemetry" Grid.Row="19" Grid.ColumnSpan="2" Text="—" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Face gallery">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,5,8,5">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,17 7,15 12,15 C17,15 20,17 20,21"
                                                      Grid.Column="0"
                                                      Width="25"
                                                      Height="25"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeLineJoin="Round"
                                                      Margin="0,0,7,0" />
                                                <TextBlock x:Name="FaceGalleryPeopleCountText"
                                                           AutomationProperties.AutomationId="FaceGalleryPeopleCount"
                                                           Grid.Column="1"
                                                           Text="—"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8,5">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="M3,7 L12,2 L21,7 L12,12 Z M3,12 L12,17 L21,12 M3,17 L12,22 L21,17"
                                                      Grid.Column="0"
                                                      Width="27"
                                                      Height="27"
                                                      Stretch="Uniform"
                                                      Stroke="#17233B"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"
                                                      Margin="0,0,7,0" />
                                                <TextBlock x:Name="FaceGalleryActiveCountText"
                                                           AutomationProperties.AutomationId="FaceGalleryActiveCount"
                                                           Grid.Column="1"
                                                           Text="—"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Padding="8,5,0,5">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="M6,2 H15 L20,7 V22 H6 Z M15,2 V7 H20 M9,12 H17 M9,16 H17"
                                                      Grid.Column="0"
                                                      Width="25"
                                                      Height="25"
                                                      Stretch="Uniform"
                                                      Stroke="#17233B"
                                                      StrokeThickness="2"
                                                      StrokeLineJoin="Round"
                                                      Margin="0,0,7,0" />
                                                <TextBlock x:Name="FaceGalleryRecordCountText"
                                                           AutomationProperties.AutomationId="FaceGalleryRecordCount"
                                                           Grid.Column="1"
                                                           Text="—"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" MinHeight="68" MaxHeight="240">
                                        <ListBox x:Name="FaceEnrollmentList"
                                                 AutomationProperties.AutomationId="FaceEnrollmentList"
                                                 MinHeight="68"
                                                 MaxHeight="240"
                                                 Background="{StaticResource SurfaceMutedBrush}"
                                                 BorderBrush="{StaticResource BorderBrush}"
                                                 BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ItemsSource="{Binding EnrollmentPeople}"
                                                 SelectedItem="{Binding SelectedEnrollmentPerson, Mode=TwoWay}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#EFF6FF" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Width="34"
                                                                    Height="34"
                                                                    CornerRadius="17"
                                                                    Background="#E5E7EB"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding InitialLabel}"
                                                                           FontSize="17"
                                                                           Foreground="#374151"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <Grid Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0"
                                                                           Text="{Binding Name}"
                                                                           FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding PersonId}"
                                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding DetailsLabel}"
                                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap" />
                                                            </Grid>
                                                            <Border Grid.Column="2"
                                                                    Padding="8,4"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="{x:Type Border}">
                                                                        <Setter Property="Background" Value="#F3F4F6" />
                                                                        <Setter Property="BorderBrush" Value="#D1D5DB" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="TextElement.Foreground" Value="#475569" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="active">
                                                                                <Setter Property="Background" Value="#DCFCE7" />
                                                                                <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                                <Setter Property="TextElement.Foreground" Value="#166534" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding StatusLabel}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"
                                                                           TextAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="FaceGalleryListEmptyText"
                                                   AutomationProperties.AutomationId="FaceGalleryEmpty"
                                                   Text="Nessuna persona nella cartella selezionata"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="20"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,10,0,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RefreshFaceGalleryButton"
                                                AutomationProperties.AutomationId="RefreshFaceGallery"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,6,8"
                                                Style="{StaticResource FaceGalleryActionButtonStyle}"
                                                Click="RefreshFaceGallery_Click"
                                                IsEnabled="{Binding CanRefreshFaceGallery}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="M20,11 A8,8 0 1 0 18,17 M20,4 V11 H13"
                                                      Grid.Column="0"
                                                      Width="23"
                                                      Height="23"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeLineJoin="Round" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Aggiorna persone"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="7,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="ActivateFacePeopleButton"
                                                AutomationProperties.AutomationId="ActivateFacePeople"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="6,0,0,8"
                                                Style="{StaticResource FaceGalleryActionButtonStyle}"
                                                Click="ActivateFacePeople_Click"
                                                IsEnabled="{Binding CanActivateFacePeople}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M7,12 L10.5,15.5 L17.5,8.5"
                                                      Grid.Column="0"
                                                      Width="23"
                                                      Height="23"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2.2"
                                                      StrokeLineJoin="Round" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Attiva persone"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="7,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="RemoveFacePersonButton"
                                                AutomationProperties.AutomationId="RemoveFacePerson"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource FaceGalleryDeleteButtonStyle}"
                                                Click="RemoveFacePerson_Click"
                                                IsEnabled="{Binding CanRemoveSelectedPerson}"
                                                Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Grid.Column="0"
                                                         Width="24"
                                                         Height="24"
                                                         Stretch="Uniform"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,7,0">
                                                    <Path Data="M6,7 H18 V20 H6 Z M4,5 H20 M9,5 V3 H15 V5 M10,10 V17 M14,10 V17"
                                                          Width="24"
                                                          Height="24"
                                                          Stretch="Uniform"
                                                          Stroke="#DC2626"
                                                          StrokeThickness="2"
                                                          StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Viewbox>
                                                <TextBlock Grid.Column="1"
                                                           Text="Elimina persona"
                                                           Foreground="#B91C1C"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="7,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <Button x:Name="FaceGalleryRootButton"
                                            AutomationProperties.AutomationId="SelectFaceGalleryRoot"
                                            Grid.Row="3"
                                            Style="{StaticResource FaceGalleryRootButtonStyle}"
                                            Click="SelectFaceGalleryRoot_Click"
                                            IsEnabled="{Binding CanSelectFaceGalleryRoot}"
                                            ToolTip="Seleziona la cartella sorgente della Face gallery">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Data="M3,5 H9 L11,7 H21 V20 H3 Z"
                                                  Grid.Column="0"
                                                  Width="28"
                                                  Height="24"
                                                  Stretch="Uniform"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="2.1"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Seleziona cartella madre delle persone"
                                                       FontSize="14"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <TextBlock x:Name="FaceGalleryText"
                                               AutomationProperties.AutomationId="FaceGallerySummary"
                                               Grid.Row="4"
                                               Text="—"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="2,8,2,0" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Face capability matrix">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                        <Button x:Name="RefreshFaceCapabilitiesButton"
                                                AutomationProperties.AutomationId="RefreshFaceCapabilities"
                                                Content="Aggiorna capabilities"
                                                Style="{StaticResource CommandButtonStyle}"
                                                Click="RefreshFaceCapabilities_Click"
                                                Margin="0" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Modello" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="Backend" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="Rich." FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="Effettivo" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock Grid.Column="4" Text="Stato" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                        <TextBlock Grid.Column="5" Text="Motivazione" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
                                    </Grid>
                                    <ItemsControl x:Name="FaceCapabilityMatrix"
                                                  AutomationProperties.AutomationId="FaceCapabilityMatrix"
                                                  ItemsSource="{Binding FaceCapabilities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.7*" />
                                                        <ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="0.7*" />
                                                        <ColumnDefinition Width="0.8*" />
                                                        <ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ModelId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Backend}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Device}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding EffectiveDeviceLabel}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusLabel}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Telemetria locale">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Stato" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock x:Name="DetectionStatusText" Grid.Row="0" Grid.Column="1" Text="DISABILITATO" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Text="Modello" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock x:Name="DetectionModelTelemetryText" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Text="Provider" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock x:Name="DetectionDeviceTelemetryText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="3" Text="Latenza / FPS" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,7" />
                                    <TextBlock x:Name="DetectionPerformanceTelemetryText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="4" Text="Rilevati" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock x:Name="DetectionCountTelemetryText" Grid.Row="4" Grid.Column="1" Text="0" />
                                </Grid>
                            </GroupBox>
                            <TextBlock x:Name="PersonStatusDetailText"
                                       Text="Identità persone non attiva"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,14" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
